<%!-- SPDX-License-Identifier: MemHouse-Sustainable-Use-1.0 --%>
<%!--
  Sign-in page for the browser console. This is the door people use; a machine
  API key has nothing it can present here, which is what keeps agents out of
  the browser surface.

  Assigns: @invalid_credentials? (boolean, show the rejection notice) and
  @csrf_token.

  Served to anonymous visitors, so it renders nothing but the form: no memory,
  no account or peer details, and no hint about why an attempt failed.

  Styling comes entirely from the linked stylesheet and this template adds no
  script of its own. The page must work under a Content-Security-Policy that
  forbids inline script and permits only same-origin sources.
--%>
<main class="auth">
  <div class="auth-card">
    <p class="brand-mark" aria-hidden="true">◈</p>
    <h1>MemHouse</h1>
    <p class="lede">Sign in to explore the memory your roles reach.</p>

    <%!--
      One message for every rejection: wrong password, unknown email, or a
      credential that is not a password identity. Never make this specific —
      naming the reason would reveal which addresses exist. role="alert" so a
      screen reader announces it after the failed attempt reloads the page.
    --%>
    <p :if={@invalid_credentials?} class="flash error" role="alert">
      Those credentials were not accepted.
    </p>

    <form method="post" action={~p"/sign-in"} class="auth-form">
      <%!--
        Required: the POST route verifies this token and rejects the request
        without it, so removing the field breaks sign-in entirely rather than
        merely loosening a check.
      --%>
      <input type="hidden" name="_csrf_token" value={@csrf_token} />
      <label>
        Email
        <input type="email" name="email" autocomplete="username" required />
      </label>
      <label>
        Password
        <input type="password" name="password" autocomplete="current-password" required />
      </label>
      <button type="submit" class="primary">Sign in</button>
    </form>

    <p class="auth-foot">
      Curators reviewing the gate queue can go straight to the
      <a href={~p"/governance"}>curator queue</a>.
    </p>
  </div>
</main>
