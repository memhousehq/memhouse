# SPDX-License-Identifier: Apache-2.0
# Generated by scripts/release/homebrew.sh from packaging/homebrew/memhouse.rb.in and the
# release's SHA256SUMS. Do not edit in the tap: change the template.
class Memhouse < Formula
  desc "Governed memory service for AI agents"
  homepage "https://github.com/memhousehq/memhouse"
  version "@VERSION@"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/memhousehq/memhouse/releases/download/v@VERSION@/memhouse-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_AARCH64_APPLE_DARWIN@"
    end
    # No release binary for Intel Macs (the bundled ONNX Runtime has no build for them):
    # build from source there, docs/install.md.
    depends_on arch: :arm64
  end

  on_linux do
    on_arm do
      url "https://github.com/memhousehq/memhouse/releases/download/v@VERSION@/memhouse-@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_AARCH64_UNKNOWN_LINUX_GNU@"
    end
    on_intel do
      url "https://github.com/memhousehq/memhouse/releases/download/v@VERSION@/memhouse-@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_X86_64_UNKNOWN_LINUX_GNU@"
    end
  end

  def install
    bin.install "memhouse"
    doc.install "README.md", "CHANGELOG.md", "NOTICE"
  end

  def caveats
    <<~EOS
      Start with one of:
        memhouse up --lite    # one SQLite file, no database server
        memhouse up           # Postgres + pgvector in Docker
    EOS
  end

  test do
    assert_match "memhouse #{version}", shell_output("#{bin}/memhouse --version")
  end
end
