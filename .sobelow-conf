# SPDX-License-Identifier: MemHouse-Sustainable-Use-1.0
#
# Sobelow (Phoenix security scanner) configuration, read by `mix sobelow --config`. Run it for
# any change touching the web layer, authentication, tenancy, or raw SQL.
[
  # Exit non-zero as soon as a low-or-higher finding appears, so CI blocks.
  exit: :low,
  format: "txt",
  # Empty on purpose. Prefer an explained per-call-site skip over a blanket
  # exclusion — see the note above.
  ignore_files: [],
  ignore: [],
  # nil writes the report to stdout rather than a file.
  out: nil,
  # Skips Sobelow's check for a newer version of itself, so a scan makes no
  # outbound network call.
  private: true,
  # nil lets Sobelow discover the Phoenix router itself.
  router: nil,
  # Honour `# sobelow_skip` annotations in source.
  skip: true,
  # Report everything from low confidence upward.
  threshold: :low,
  verbose: false,
  version: false
]
