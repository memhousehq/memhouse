# SPDX-License-Identifier: Apache-2.0
# Settings for the publication (roadmap G09). Copy to publish.env (not committed). No secret
# belongs here.

# The identity every commit of the public history carries (author, committer, Signed-off-by):
# the GitHub no-reply address, <id>+<login>@users.noreply.github.com.
PUBLIC_NAME="Aleksei Popov"
PUBLIC_EMAIL="3368890+aleksei-s-popov@users.noreply.github.com"
GITHUB_LOGIN="aleksei-s-popov"

# GitHub organisation and repositories. REPO already exists (the Elixir 0.x implementation):
# forge-setup.sh keeps its history on LEGACY_BRANCH and replaces main.
ORG="memhousehq"
REPO="memhouse"
FORMAT_REPO="memory-format"
LEGACY_BRANCH="legacy/elixir"

# "rewritten": the full history, rewritten; "fresh": one commit with the current tree.
HISTORY="rewritten"

# Private names and phrases to replace and check for, kept outside this repository.
PRIVATE_TERMS="../private-repo/g09/private-terms.txt"

# Where the publishable copies are built (outside this repository).
WORKDIR="../memhouse-publish"
