# SPDX-License-Identifier: Apache-2.0
# Settings for the publication (roadmap G09). Copy to publish.env (not committed) and fill in
# the founder's decisions. No secret belongs here.

# The identity every commit of the public history carries (author, committer, Signed-off-by),
# e.g. a forge no-reply address such as 12345678+handle@users.noreply.github.com.
PUBLIC_NAME="Aleksei Popov"
PUBLIC_EMAIL="founder@example.invalid"

# The forge organisation and repositories.
ORG="memhouse"
REPO="memhouse"
FORMAT_REPO="memory-format"

# "rewritten": the full history, rewritten; "fresh": one commit with the current tree.
HISTORY="rewritten"

# Where the publishable copies are built (outside this repository).
WORKDIR="../memhouse-publish"
