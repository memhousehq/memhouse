# SPDX-License-Identifier: MemHouse-Sustainable-Use-1.0

# Local Phoenix server port.
PORT=4000

# Source-development connection. Packaged releases default to supervised pg0
# and generate their own data paths; containers use external Postgres.
DATABASE_URL=ecto://postgres:postgres@localhost:5432/memhouse_dev
POOL_SIZE=10
# MEMHOUSE_DATABASE_MODE=external
# MEMHOUSE_AUTO_MIGRATE=false
# MEMHOUSE_PG0_BINARY=/absolute/path/to/pg0
# MEMHOUSE_PG0_DATA_DIR=/absolute/path/to/memhouse-pg0-data
# MEMHOUSE_PG0_PORT=5432
# MEMHOUSE_PG0_DATABASE=memhouse
# MEMHOUSE_PG0_USERNAME=postgres
# MEMHOUSE_PG0_PASSWORD=postgres

# PostgreSQL row-level security is skipped for a superuser or a role granted
# BYPASSRLS, so MemHouse provisions this restricted role and switches every
# connection to it. The connecting role above needs CREATEROLE for that to
# succeed automatically; otherwise create a NOSUPERUSER NOBYPASSRLS login by
# hand and point DATABASE_URL at it instead. See docs/reference/configuration.md.
# MEMHOUSE_DATABASE_APP_ROLE=memhouse_app
# MEMHOUSE_ALLOW_UNRESTRICTED_DATABASE_ROLE=false

# Standalone-release updates. Containers and external PostgreSQL only report
# availability; they never replace themselves.
MEMHOUSE_UPDATE_CHECK=true
MEMHOUSE_AUTO_UPDATE=off
MEMHOUSE_UPDATE_CHECK_INTERVAL_HOURS=24
# MEMHOUSE_UPDATE_INSTALL_ROOT=/absolute/path/holding/current-and-releases
# MEMHOUSE_UPDATE_SOURCE=https://api.github.com/repos/memhousehq/memhouse/releases/latest

# Free-core identity. Generate independent random production secrets; do not
# reuse SECRET_KEY_BASE. The bootstrap password is read only by the one-time
# identity task and need not remain in .env afterward.
MEMHOUSE_FREE_ACCOUNT_KEY=local
MEMHOUSE_FREE_ACCOUNT_NAME=Local MemHouse
MEMHOUSE_AUTH_SIGNING_SECRET=
MEMHOUSE_BOOTSTRAP_PASSWORD=

# Provider-neutral generation roles. The deterministic provider is an
# explicit test/local fallback only; production defaults local fallback off and
# never selects it after a live provider fails.
MEMHOUSE_MODEL_PROVIDER=openrouter
MEMHOUSE_MODEL_LOCAL_FALLBACK=true
MEMHOUSE_OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
MEMHOUSE_MODEL_VERSION=unversioned
MEMHOUSE_MODEL_INGEST=openai/gpt-oss-120b
MEMHOUSE_MODEL_DREAM=openai/gpt-oss-120b
MEMHOUSE_MODEL_ASK=openai/gpt-oss-120b
# Three settings shared by all three generation roles that keep a reasoning
# model from blowing its context window or getting killed by a short timeout.
# reasoning_effort bounds spend before output is emitted (the primary lever);
# max_tokens is the hard backstop; receive_timeout covers reasoning models
# ReqLLM does not itself recognize as needing a longer default timeout.
MEMHOUSE_MODEL_REASONING_EFFORT=low
MEMHOUSE_MODEL_MAX_TOKENS=8192
MEMHOUSE_MODEL_RECEIVE_TIMEOUT_MS=120000
# Total model-call ceiling. This is independent of the per-chunk receive
# timeout, so provider keep-alives cannot leave an extraction running forever.
MEMHOUSE_MODEL_REQUEST_TIMEOUT_MS=300000
# ReqLLM shares these outbound connections across all hosted generation roles.
# `size` is the capacity of one HTTP/1 shard; leave `count` at one unless a
# measured single-shard bottleneck requires more shards. Match size to expected
# concurrent calls and keep the checkout timeout aligned with model latency.
MEMHOUSE_MODEL_STREAM_POOL_SIZE=16
MEMHOUSE_MODEL_STREAM_POOL_COUNT=1
MEMHOUSE_MODEL_POOL_TIMEOUT_MS=120000
# Maximum concurrent extraction jobs per node. Raising this also requires a
# matching model stream-pool size and provider capacity.
MEMHOUSE_INGEST_QUEUE_LIMIT=10

# Pinned embedding role. Ortex reads local artifacts and performs no download.
# Set absolute paths before invoking the embedder.
MEMHOUSE_EMBEDDING_PROVIDER=ortex
MEMHOUSE_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
MEMHOUSE_EMBEDDING_VERSION=onnx-1-qwen3-1024
MEMHOUSE_EMBEDDING_DIMENSIONS=1024
MEMHOUSE_ORTEX_MODEL_PATH=
MEMHOUSE_ORTEX_TOKENIZER_PATH=
MEMHOUSE_ORTEX_EXECUTION_PROVIDERS=cpu
MEMHOUSE_ORTEX_POOLING=last_token
MEMHOUSE_ORTEX_QUERY_INSTRUCTION=Given a web search query, retrieve relevant passages that answer the query

# StreamingDiskANN index build and query tuning. Change build settings only with
# an index rebuild. Zero dimensions indexes the full 1024-dimensional vector.
MEMHOUSE_DISKANN_STORAGE_LAYOUT=memory_optimized
MEMHOUSE_DISKANN_NUM_NEIGHBORS=50
MEMHOUSE_DISKANN_SEARCH_LIST_SIZE=100
MEMHOUSE_DISKANN_MAX_ALPHA=1.2
MEMHOUSE_DISKANN_NUM_DIMENSIONS=0
MEMHOUSE_DISKANN_QUERY_SEARCH_LIST_SIZE=100
MEMHOUSE_DISKANN_QUERY_RESCORE=50

# For an API embedder, set MEMHOUSE_EMBEDDING_PROVIDER=openai-compatible and
# configure these without persisting the raw key in ModelRoleConfig.
MEMHOUSE_EMBEDDING_BASE_URL=
MEMHOUSE_EMBEDDING_API_KEY=

# Budget admission and self-host cost visibility. Limits are daily token
# counters; dream-time is throttled first. Rates are USD per million tokens.
MEMHOUSE_BUDGET_LIMITS_JSON={"input_tokens":1000000,"output_tokens":250000,"embedding_tokens":2000000}
MEMHOUSE_MODEL_COSTS_JSON={"ingest_extractor":{"input":0.0,"output":0.0},"dream_reasoner":{"input":0.0,"output":0.0},"dialectic_agent":{"input":0.0,"output":0.0},"embedder":{"embedding":0.0}}

# Document storage, parsing, and chunking. Local blobs are content-addressed
# beneath MEMHOUSE_BLOB_ROOT. Leave the variable unset to use the environment
# default. For S3, configure ExAws credentials through its standard AWS
# environment in addition to the bucket, prefix, and optional compatible host.
MEMHOUSE_BLOB_ADAPTER=local
# MEMHOUSE_BLOB_ROOT=/absolute/path/to/memhouse-blobs
MEMHOUSE_S3_BUCKET=
MEMHOUSE_S3_PREFIX=memhouse
# MEMHOUSE_S3_HOST=localhost
# MEMHOUSE_S3_SCHEME=http://
# MEMHOUSE_S3_PORT=9000
# AWS_REGION=us-east-1
MEMHOUSE_DOCUMENT_CHUNK_SIZE=1200
MEMHOUSE_DOCUMENT_CHUNK_OVERLAP=160
MEMHOUSE_DOCUMENT_MAX_EXTRACT_LENGTH=500000

# Development observability. Start the local collector with:
# docker compose -f dev/observability/docker-compose.yml up
MEMHOUSE_OTEL_ENABLED=false
MEMHOUSE_ENVIRONMENT=development
OTEL_SERVICE_NAME=memhouse-dev
MEMHOUSE_EXPERIMENT_NAME=local-dev
MEMHOUSE_EXPERIMENT_RUN_ID=manual
MEMHOUSE_RETRIEVAL_VARIANT=poc-baseline
MEMHOUSE_RETRIEVAL_RERANK_TIMEOUT_MS=750
OTEL_EXPORTER_OTLP_PROTOCOL=http_protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14318
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0

# Span category controls. Keep HTTP, memory, model, and Oban enabled for normal
# workflow traces. Enable Phoenix/Ecto spans only for deep framework/database
# debugging because they add a lot of low-level spans.
MEMHOUSE_OTEL_HTTP_SPANS_ENABLED=true
MEMHOUSE_OTEL_PHOENIX_SPANS_ENABLED=true
MEMHOUSE_OTEL_MEMORY_SPANS_ENABLED=true

# Declares this whole deployment process has no human governance participant.
# When true, personal knowledge above peer level has its subject consent
# auto-granted instead of blocked pending a real subject. Off by default —
# only set this for a benchmark, evaluation, or synthetic-data deployment.
MEMHOUSE_GOVERNANCE_UNATTENDED=false
MEMHOUSE_OTEL_MODEL_SPANS_ENABLED=true
MEMHOUSE_OTEL_DOCUMENT_SPANS_ENABLED=true
MEMHOUSE_OTEL_OBAN_SPANS_ENABLED=true
MEMHOUSE_OTEL_OBAN_SPAN_RELATIONSHIP=child
MEMHOUSE_OTEL_ECTO_SPANS_ENABLED=false

# Disabled by default because SQL statements can include sensitive values.
MEMHOUSE_OTEL_DB_STATEMENT_ENABLED=false

# Optional direct-to-Langfuse OTLP config. Prefer the local collector profile
# during development so traces can also be inspected locally.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Basic <base64-public-key-colon-secret-key>,x-langfuse-ingestion-version=4

# Production-only settings. Not needed for `mix phx.server` in dev.
PHX_HOST=localhost
PHX_SERVER=false
SECRET_KEY_BASE=
DNS_CLUSTER_QUERY=
ECTO_IPV6=false
