# Copy to .env (ignored by git) and fill in locally. Never commit real values.
# Load it for one command with:   set -a; . ./.env; set +a
# or keep the values in a password manager and run:   op run --env-file=.env.example -- <command>
# (with op:// references instead of values). See docs/security/secrets.md.

# LLM key for paid benchmark tiers (T2-T4) and local enrichment. OpenRouter keys work with
# --llm-base-url https://openrouter.ai/api/v1. Set a spend cap on the key at the provider.
OPENAI_API_KEY=

# Optional: a separate MemHouse home for development, so ~/.memhouse is never touched.
# MEMHOUSE_HOME=./.dev-home

# Optional: point at your own Postgres instead of `memhouse up`.
# MEMHOUSE_DATABASE_URL=postgres://memhouse:<password>@127.0.0.1:5432/memhouse
