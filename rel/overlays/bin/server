#!/bin/sh
# SPDX-License-Identifier: MemHouse-Sustainable-Use-1.0
#
# Unix/macOS entry point for a running MemHouse node: the command a person runs
# after unpacking the release.
#
# Purpose
#   Make "unpack and run" work with zero configuration, while leaving every
#   decision overridable. It provisions a private data directory and a signing
#   secret on first run, defaults the node to supervising its own embedded
#   PostgreSQL, and then hands off to the generated release launcher.
#
# Environment (all optional; anything already set is respected)
#   MEMHOUSE_DATA_ROOT      Where local state lives. Default ~/.memhouse.
#   MEMHOUSE_AUTH_SIGNING_SECRET  Token signing key. Generated and persisted on
#                            first run if absent.
#   MEMHOUSE_DATABASE_MODE  `pg0` (embedded, the default here) or `external`.
#   MEMHOUSE_AUTO_MIGRATE   Apply pending migrations during boot.
#   MEMHOUSE_PG0_BINARY     Path to the embedded PostgreSQL launcher.
#   MEMHOUSE_PG0_DATA_DIR   PostgreSQL cluster directory.
#   MEMHOUSE_BLOB_ROOT      Local document blob storage directory.
#   Plus everything the application itself reads (HTTP port, model settings,
#   and so on), which this script neither sets nor inspects.
#
# Outputs
#   A running node in the foreground. On first run it also creates the data
#   root, the signing secret file, and — indirectly, once the node boots — the
#   PostgreSQL cluster and blob directories.
#
# Assumptions
#   This launcher is for the unpacked release only. The container image never
#   calls it: it invokes the generated launcher directly and sets its own
#   database mode, migration policy, and server flag. That image also contains
#   no pg0 at all and is given a stock PostgreSQL service instead. Do not add an
#   embedded database to the container path — two servers would contend for one
#   data volume.
#
# Failure behaviour
#   `set -eu` aborts before starting the node if the data root cannot be created
#   or the secret cannot be generated. Invalid configuration is rejected by the
#   node's own startup validation, which runs before any durable service.
set -eu

# `$0` is <release>/bin/server, so the parent of its directory is the release
# root. Resolving it this way keeps the release relocatable: it can be unpacked
# anywhere and invoked through any path or symlinked working directory. CDPATH
# is cleared because a value in the caller's environment could make `cd` land
# somewhere else entirely and print the wrong directory.
release_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
data_root=${MEMHOUSE_DATA_ROOT:-"$HOME/.memhouse"}
secret_file="$data_root/auth-signing-secret"

mkdir -p "$data_root"
# The data root holds the signing secret, the database cluster, and document
# blobs — everything the owner's memory is made of. Owner-only access keeps
# other local accounts from reading it.
chmod 0700 "$data_root"

# Generate the signing secret once and persist it, rather than minting a new one
# per boot: a fresh secret would silently invalidate every previously issued
# token on every restart. 48 bytes are read from the kernel CSPRNG, which
# base64-encodes to exactly 64 characters — the minimum a production boot
# accepts, since it refuses to start on a short or missing secret rather than
# falling back to something guessable. `umask 077` is set before the redirect,
# so the file is owner-only from the instant it is created rather than being
# briefly readable and tightened afterwards.
if [ -z "${MEMHOUSE_AUTH_SIGNING_SECRET:-}" ]; then
  if [ ! -f "$secret_file" ]; then
    umask 077
    dd if=/dev/urandom bs=48 count=1 2>/dev/null | base64 > "$secret_file"
  fi

  # base64 output may be line-wrapped depending on the implementation; strip line
  # endings so the value is one contiguous secret and not a truncated first line.
  MEMHOUSE_AUTH_SIGNING_SECRET=$(tr -d '\r\n' < "$secret_file")
  export MEMHOUSE_AUTH_SIGNING_SECRET
fi

# `: "${VAR:=default}"` assigns only when the variable is unset or empty, so an
# operator's exported value always wins over these local-first defaults.
#
# The database default is the embedded engine: someone who just unpacked the
# release has no PostgreSQL to point at. The pg0 binary is looked up inside the
# release itself, because the packaging script stages it there. Migrations run
# during boot, before the node serves traffic. Ordering is enforced by the node,
# not here: the embedded PostgreSQL is started before the Repo connects and
# before migrations run, since neither can do anything until the engine is up.
: "${MEMHOUSE_DATABASE_MODE:=pg0}"
: "${MEMHOUSE_AUTO_MIGRATE:=true}"
: "${MEMHOUSE_PG0_BINARY:=$release_root/bin/pg0}"
: "${MEMHOUSE_PG0_DATA_DIR:=$data_root/pg0/instances/memhouse/data}"
: "${MEMHOUSE_BLOB_ROOT:=$data_root/blobs}"

# Defaults resolved above are only useful to the node if they are exported into
# its environment; the runtime configuration reads them as environment variables.
export MEMHOUSE_DATABASE_MODE
export MEMHOUSE_AUTO_MIGRATE
export MEMHOUSE_PG0_BINARY
export MEMHOUSE_PG0_DATA_DIR
export MEMHOUSE_BLOB_ROOT
# Without this the release boots the application but never starts the HTTP
# endpoint, which is the correct behaviour for `remote`/`eval`/`rpc` style
# invocations and the wrong one for a server.
export PHX_SERVER=true

# After a manual update, an older launcher may still be the command in a
# shell's history. Follow the atomically switched pointer so it cannot restart
# old code against a newer schema.
update_root=${MEMHOUSE_UPDATE_INSTALL_ROOT:-"$(dirname -- "$release_root")"}
if [ -d "$update_root/current" ]; then
  active_root=$(CDPATH= cd -- "$update_root/current" && pwd)
  if [ "$active_root" != "$release_root" ]; then
    exec "$active_root/bin/server"
  fi
fi

# A running BEAM node never replaces its own executable tree. The optional
# update happens here, before this process starts the server, and the stable
# install root is followed only after an atomic pointer switch completed.
if [ "${MEMHOUSE_AUTO_UPDATE:-off}" = "minor" ] && [ -x "$release_root/bin/update" ]; then
  "$release_root/bin/update" --auto || echo "MemHouse automatic update was not applied; see bin/update --check" >&2

  if [ -d "$update_root/current" ]; then
    active_root=$(CDPATH= cd -- "$update_root/current" && pwd)
    if [ "$active_root" != "$release_root" ]; then
      exec "$active_root/bin/server"
    fi
  fi
fi

# `exec` replaces this shell with the release launcher so the node keeps this
# process id. That is what lets a supervisor, a container runtime, or Ctrl-C
# deliver signals straight to the node and get an orderly shutdown — which is
# also what stops the embedded PostgreSQL cleanly.
exec "$release_root/bin/memhouse" start
