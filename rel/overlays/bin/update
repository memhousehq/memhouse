#!/bin/sh
# SPDX-License-Identifier: MemHouse-Sustainable-Use-1.0
#
# Checks or applies a signed MemHouse release update. This entry point is for
# the standalone pg0 package; containers and external PostgreSQL are reported
# as managed deployments and are never replaced here.
set -eu

release_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

case "${1:---check}" in
  --check)
    exec "$release_root/bin/memhouse" eval 'IO.inspect(MemHouse.Update.check())'
    ;;
  --auto)
    exec "$release_root/bin/memhouse" eval 'case MemHouse.Update.check() do %{automatic_eligible: true, available_version: version} -> MemHouse.Update.apply!(version); result -> IO.inspect(result) end'
    ;;
  --version)
    version=${2:?--version requires a semantic version}
    case "$version" in
      *[!0-9.]*|*.*.*.*|.*|*.) echo "version must be MAJOR.MINOR.PATCH" >&2; exit 64 ;;
    esac
    exec "$release_root/bin/memhouse" eval "MemHouse.Update.apply!(\"$version\")"
    ;;
  *)
    echo "usage: bin/update [--check | --auto | --version MAJOR.MINOR.PATCH]" >&2
    exit 64
    ;;
esac
