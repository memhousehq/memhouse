{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Values of the MemHouse chart",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "database"],
  "properties": {
    "global": { "type": "object" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "database": {
      "description": "The Postgres URL comes from an existing Secret; a URL or a password is never a value.",
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "urlKey"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "urlKey": { "type": "string", "minLength": 1 }
      }
    },
    "apiKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publicUrl": { "type": "string", "pattern": "^(https?://.+)?$" }
      }
    },
    "config": {
      "description": "MemHouse's configuration as a map (rendered to TOML). The database URL and API keys are not set here.",
      "type": "object",
      "properties": {
        "database": {
          "type": "object",
          "not": { "required": ["url"] }
        },
        "server": {
          "type": "object",
          "not": { "anyOf": [{ "required": ["api_keys"] }, { "required": ["bind"] }] }
        }
      }
    },
    "extraEnv": { "type": "array", "items": { "type": "object", "required": ["name"] } },
    "extraEnvFrom": { "type": "array", "items": { "type": "object" } },
    "modelCache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "emptyDir": { "type": "object" },
        "existingClaim": { "type": "string" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automount": { "type": "boolean" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "paths"],
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "pathType"],
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "enum": ["Prefix", "Exact", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array", "items": { "type": "object" } }
      }
    },
    "resources": { "type": "object" },
    "startupProbe": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" }
  }
}
